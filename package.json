{
  "name": "sf-app-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Salesforce mobile (com.salesforce.chatter) automation - WebdriverIO + Appium on BrowserStack App Automate",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:smoke": "wdio run wdio.conf.js --mochaOpts.grep @smoke",
